/* css/style.css */
/* ========== ROOT VARIABLES - PREMIUM PINK THEME ========== */
:root {
    --pink-bg: #fef5f7;
    --pink-dark: #fce4ec;
    --card-white: #ffffff;
    --accent-pink: #e8436e;
    --accent-soft: #ff9eb5;
    --accent-light: #ffb6c7;
    --accent-gold: #d4af37;
    --text-dark: #2d1b22;
    --text-muted: #8b5a6e;
    --border-pink: #ffcddc;
    --shadow-sm: 0 4px 12px rgba(232, 67, 110, 0.08);
    --shadow-md: 0 8px 24px rgba(232, 67, 110, 0.12);
    --shadow-lg: 0 20px 40px rgba(232, 67, 110, 0.2);
    --shadow-hover: 0 25px 45px rgba(232, 67, 110, 0.25);
    --transition-fast: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --transition-bounce: all 0.5s cubic-bezier(0.34, 1.2, 0.64, 1);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    background: linear-gradient(135deg, var(--pink-bg) 0%, var(--pink-dark) 100%);
    color: var(--text-dark);
    line-height: 1.5;
    overflow-x: hidden;
    min-height: 100vh;
}

/* Custom Scrollbar */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: var(--pink-dark); border-radius: 10px; }
::-webkit-scrollbar-thumb { background: var(--accent-pink); border-radius: 10px; }

/* Mobile Sidebar */
.site-wrapper { display: flex; position: relative; min-height: 100vh; }
.mobile-sidebar {
    position: fixed; top: 0; left: 0; width: 300px; height: 100vh;
    background: rgba(255, 245, 248, 0.98); backdrop-filter: blur(10px);
    z-index: 1100; transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    box-shadow: 8px 0 30px rgba(232, 67, 110, 0.2);
    border-right: 1px solid var(--border-pink);
    display: flex; flex-direction: column; overflow-y: auto;
}
.mobile-sidebar.open { transform: translateX(0); }
.sidebar-header {
    padding: 2rem 1.5rem; border-bottom: 2px solid var(--accent-light);
    background: linear-gradient(135deg, #fff0f4, #fff5f8);
    display: flex; justify-content: space-between; align-items: center;
}
.sidebar-header h3 { font-family: 'Playfair Display', serif; font-size: 1.5rem; color: var(--accent-pink); }
.close-sidebar {
    background: none; border: none; color: var(--text-muted);
    font-size: 1.6rem; cursor: pointer; transition: var(--transition-fast);
}
.close-sidebar:hover { color: var(--accent-pink); transform: rotate(90deg); }
.sidebar-nav {
    flex: 1; padding: 2rem 1rem 2rem 1.8rem;
    display: flex; flex-direction: column; gap: 1.2rem;
}
.sidebar-nav a {
    color: var(--text-dark); text-decoration: none; font-size: 1.15rem;
    font-weight: 500; display: flex; align-items: center; gap: 1rem;
    transition: var(--transition-fast); padding: 0.7rem 0; border-radius: 12px;
}
.sidebar-nav a i { width: 28px; color: var(--accent-pink); font-size: 1.2rem; transition: var(--transition-fast); }
.sidebar-nav a:hover, .sidebar-nav a.active { color: var(--accent-pink); transform: translateX(8px); }
.sidebar-nav a:hover i { transform: scale(1.1); }
.sidebar-footer { padding: 1.5rem; border-top: 1px solid var(--border-pink); font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; }

/* Main Content */
.main-content { flex: 1; width: 100%; }

/* Mobile Header */
.mobile-header {
    background: rgba(255, 245, 248, 0.95); backdrop-filter: blur(12px);
    padding: 1rem 1.5rem; display: flex; align-items: center;
    justify-content: space-between; border-bottom: 1px solid var(--border-pink);
    position: sticky; top: 0; z-index: 100;
}
.menu-icon { background: none; border: none; color: var(--accent-pink); font-size: 1.8rem; cursor: pointer; transition: var(--transition-fast); }
.menu-icon:hover { transform: scale(1.05); }
.logo-area h1 { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; }
.logo-area p { font-size: 0.65rem; color: var(--accent-pink); letter-spacing: 1.5px; font-weight: 500; }
.order-cta {
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-soft));
    color: white; padding: 0.5rem 1rem; border-radius: 40px; font-size: 0.75rem;
    font-weight: 600; text-decoration: none; transition: var(--transition-fast);
    box-shadow: var(--shadow-sm);
}
.order-cta:hover { transform: scale(0.96); box-shadow: var(--shadow-md); }

/* Overlay */
.overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(3px);
    z-index: 1050; opacity: 0; visibility: hidden; transition: all 0.3s;
}
.overlay.active { opacity: 1; visibility: visible; }

/* Page Sections */
.section { padding: 3rem 1.5rem; max-width: 1280px; margin: 0 auto; animation: fadeInUp 0.6s ease-out; }
.section-title {
    font-family: 'Playfair Display', serif; font-size: 2rem;
    margin-bottom: 2.5rem; position: relative; display: inline-block;
}
.section-title::after {
    content: ''; position: absolute; bottom: -10px; left: 0;
    width: 60%; height: 3px; background: linear-gradient(90deg, var(--accent-pink), var(--accent-light));
    border-radius: 3px;
}

/* Cards Grid */
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem; }
.product-card {
    background: var(--card-white); border-radius: 28px; overflow: hidden;
    transition: var(--transition-bounce); border: 1px solid var(--border-pink);
    box-shadow: var(--shadow-md); position: relative; cursor: pointer;
}
.product-card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(232,67,110,0.05), rgba(255,158,181,0.05));
    opacity: 0; transition: var(--transition-fast); pointer-events: none; border-radius: 28px;
}
.product-card:hover { transform: translateY(-12px) scale(1.02); box-shadow: var(--shadow-hover); border-color: var(--accent-pink); }
.product-card:hover::before { opacity: 1; }
.card-image { width: 100%; height: 220px; object-fit: cover; transition: var(--transition-fast); }
.product-card:hover .card-image { transform: scale(1.05); }
.card-content { padding: 1.5rem; position: relative; background: white; }
.product-card i { font-size: 2.5rem; color: var(--accent-pink); margin-bottom: 1rem; display: inline-block; transition: var(--transition-fast); }
.product-card:hover i { transform: scale(1.1) rotate(5deg); }
.product-card h3 { font-size: 1.3rem; margin-bottom: 0.5rem; font-family: 'Playfair Display', serif; }
.product-card p { color: var(--text-muted); font-size: 0.9rem; }
.price { color: var(--accent-pink); font-weight: 700; margin: 0.75rem 0; font-size: 1.2rem; }
.add-to-cart, .catering-inquiry {
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-soft));
    border: none; padding: 0.7rem 1.5rem; border-radius: 40px; color: white;
    font-weight: 600; cursor: pointer; transition: var(--transition-fast); width: 100%;
    margin-top: 0.5rem;
}
.add-to-cart:hover, .catering-inquiry:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

/* Forms */
.contact-form, .order-form, .catering-form {
    background: rgba(255, 255, 255, 0.95); padding: 2rem;
    border-radius: 32px; border: 1px solid var(--border-pink);
    backdrop-filter: blur(4px); box-shadow: var(--shadow-lg);
    transition: var(--transition-fast);
}
.contact-form:hover, .order-form:hover, .catering-form:hover { transform: translateY(-5px); box-shadow: var(--shadow-hover); }
input, textarea, select {
    width: 100%; padding: 0.9rem 1.2rem; margin: 0.6rem 0;
    background: white; border: 2px solid var(--border-pink); border-radius: 20px;
    color: var(--text-dark); font-family: 'Inter', sans-serif;
    transition: var(--transition-fast); font-size: 0.95rem;
}
input:focus, textarea:focus, select:focus {
    outline: none; border-color: var(--accent-pink);
    box-shadow: 0 0 0 4px rgba(232, 67, 110, 0.15); transform: scale(1.01);
}
button, .btn {
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-soft));
    color: white; padding: 0.9rem 2rem; border: none; border-radius: 50px;
    font-weight: 600; cursor: pointer; transition: var(--transition-fast);
    font-size: 1rem; box-shadow: var(--shadow-sm);
}
button:hover, .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

/* Map */
#map { height: 350px; width: 100%; border-radius: 28px; margin-top: 1rem; border: 2px solid var(--border-pink); z-index: 1; transition: var(--transition-fast); }
#map:hover { transform: scale(1.01); box-shadow: var(--shadow-lg); }
.contact-info { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 2rem 0; }
.info-item {
    background: white; padding: 1.5rem; border-radius: 28px; flex: 1;
    text-align: center; border: 1px solid var(--border-pink);
    transition: var(--transition-fast); cursor: pointer;
}
.info-item:hover { transform: translateY(-8px); border-color: var(--accent-pink); box-shadow: var(--shadow-lg); }
.info-item i { font-size: 2rem; color: var(--accent-pink); margin-bottom: 0.5rem; }

/* Footer */
footer { background: rgba(255, 245, 248, 0.95); text-align: center; padding: 2rem; border-top: 1px solid var(--border-pink); font-size: 0.85rem; color: var(--text-muted); }

/* Toast */
.toast-msg {
    position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px);
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-soft));
    color: white; padding: 0.8rem 1.8rem; border-radius: 60px; font-weight: 600;
    z-index: 1200; transition: transform 0.3s ease; pointer-events: none; white-space: nowrap;
    box-shadow: var(--shadow-lg);
}
.toast-msg.show { transform: translateX(-50%) translateY(0); }

/* Animations */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

@media (min-width: 768px) {
    .section { padding: 4rem 2rem; }
    .section-title { font-size: 2.5rem; }
}
@media (max-width: 600px) {
    .toast-msg { white-space: normal; text-align: center; font-size: 0.8rem; width: 85%; }
    .card-image { height: 180px; }
}
